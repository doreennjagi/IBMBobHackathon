# SubLeech Frontend Environment Configuration
# Copy this file to .env.local and fill in your values

# API Configuration
VITE_API_BASE_URL=http://localhost:8000
VITE_API_VERSION=v1

# Application Settings
VITE_APP_NAME=SubLeech
VITE_APP_VERSION=1.0.0

# Feature Flags
VITE_ENABLE_PWA=true
VITE_ENABLE_ANALYTICS=false

# IBM Cloud (if needed for direct frontend calls)
VITE_IBM_CLOUD_REGION=us-south