# OpenShift Secrets Configuration Template
# Copy this file to secrets.yaml and fill in your actual values
# DO NOT commit secrets.yaml to git

apiVersion: v1
kind: Secret
metadata:
  name: subleech-secrets
type: Opaque
stringData:
  # Database Connection
  database-url: "postgresql://user:password@hostname:5432/subleech"
  
  # Redis Connection
  redis-url: "redis://hostname:6379/0"
  
  # JWT Secret
  jwt-secret-key: "your-secret-key-here-use-openssl-rand-hex-32"
  
  # IBM Cloud API Key
  ibm-cloud-api-key: "your-ibm-cloud-api-key"
  
  # watsonx.ai Configuration
  watsonx-api-key: "your-watsonx-api-key"
  
  # watsonx Orchestrate
  orchestrate-api-key: "your-orchestrate-api-key"
  orchestrate-instance-id: "your-orchestrate-instance-id"
  
  # IBM Cloud Object Storage
  cos-api-key: "your-cos-api-key"
  cos-instance-id: "your-cos-instance-id"

---
apiVersion: v1
kind: ConfigMap
metadata:
  name: subleech-config
data:
  # watsonx Configuration
  watsonx-project-id: "your-watsonx-project-id"
  watsonx-url: "https://us-south.ml.cloud.ibm.com"
  watsonx-model-id: "ibm/granite-13b-chat-v2"
  
  # Application Settings
  log-level: "INFO"
  max-csv-size-mb: "10"
  price-hike-threshold: "0.10"